# Public URL of the deployment (used for Open Graph / link previews).
NEXT_PUBLIC_SITE_URL=https://halcyon.example.com

# Optional TURN relay for strict networks (comma-separated URLs).
# These ship to the browser: use TURN-only or short-lived credentials.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Signaling relay: max requests per client IP per 10 s (default 300).
SIGNAL_RATE_LIMIT=
